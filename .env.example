# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha. NUNCA versione o .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Webhooks — gere valores FORTES e aleatórios (não reutilize entre clientes).
# Ex.: `openssl rand -hex 32`
DATACRAZY_WEBHOOK_SECRET=
PAYT_WEBHOOK_SECRET=
SKALE_WEBHOOK_SECRET=

# Meta — código de teste do Pixel (opcional; só pra validar eventos no Test Events)
META_TEST_EVENT_CODE=

# Câmbio — cotação USD→BRL de fallback quando não há cotação do dia cadastrada
USD_BRL_FALLBACK_RATE=5.40
